 # * `DED_LDFLAGS' - Linker flags to use with `DED_LD'.
-DED_LDFLAGS="-L$XCOMP_SDKROOT/usr/lib/ -r -v"
+#DED_LDFLAGS=

 # * `DED_LD_FLAG_RUNTIME_LIBRARY_PATH' - This flag should set runtime library
